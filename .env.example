# Database Configuration (PostgreSQL via Docker on port 5433 or local instance)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/job_fastapi

# Server Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
SECRET_KEY=your-secret-key-change-me

# Groq Cloud AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Redis & ARQ Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
